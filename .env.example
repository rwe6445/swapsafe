# PayPal sandbox app (developer.paypal.com). Sandbox only: the server refuses to start with any other value.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. If empty, the app registers a webhook for its own URL on first use and looks the id up from PayPal.
PAYPAL_WEBHOOK_ID=
# Vision model for label reading (Google AI Studio key)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_DAILY_CAP=300
# Neon Postgres (injected by the Vercel integration). Without it the app uses an in-memory store (local dev only).
DATABASE_URL=
# Vercel Blob (label photos uploaded by the picker)
BLOB_READ_WRITE_TOKEN=
APP_BASE_URL=http://localhost:3000
